# ============================================================================
# 学径 (XueJing) · Personal AI Learning OS 环境变量示例
# 使用方式：复制本文件为 .env 并填入你的真实 API Key（.env 已被 .gitignore 忽略，不会上传）
# 提示：也可以不配置 .env，启动后直接在应用右上角「模型设置」面板中配置并测试连接
# ============================================================================

# 方式一：OpenAI 兼容直连（推荐：支持 DeepSeek / OpenAI / Google Gemini / OpenRouter / Ollama）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=your_api_key_here
ATLAS_MODEL=deepseek-chat

# 方式二：DeepSeek 专用环境变量（可选，若未配置 OPENAI_API_KEY 时生效）
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 方式三：Vercel AI Gateway 统一路由（可选）
# AI_GATEWAY_API_KEY=your_vercel_ai_gateway_api_key_here
# ATLAS_MODEL=openai/gpt-4.1-mini

# 本机 SQLite 数据库路径覆盖（可选，默认保存在 data/learnos.sqlite）
# LEARNOS_DB_PATH=data/learnos.sqlite
