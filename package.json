{
  "name": "xuejing-learning-os",
  "version": "0.1.0",
  "description": "学径 · 本机优先个人学习工作台",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 -p 5173",
    "desktop": "node electron/launch-desktop.cjs",
    "desktop:pack": "npm run build && npx --yes electron-builder --dir",
    "desktop:dist": "npm run build && npx --yes electron-builder",
    "typecheck": "tsc --noEmit",
    "test:logic": "node --experimental-strip-types --import ./tests/ts-loader.mjs --test tests/logic.test.ts tests/trace.test.ts tests/context.test.ts tests/domain.test.ts tests/learning-engine.test.ts tests/wave0.test.ts tests/wave1.test.ts tests/wave2.test.ts tests/wave3.test.ts tests/e2e-001.test.ts tests/research.test.ts tests/agent-native.test.ts tests/deepseek-api.test.ts tests/graph-contract.test.ts tests/visual-explainer.test.ts",
    "test:trace": "node --experimental-strip-types --import ./tests/ts-loader.mjs --test tests/trace.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.94",
    "@ai-sdk/react": "^3.0.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@xyflow/react": "^13.0.2",
    "ai": "^6.0.0",
    "beautiful-mermaid": "^1.1.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^12.3.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^45.4.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0"
  }
}
